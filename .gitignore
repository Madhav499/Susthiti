# Secrets and local configuration: never commit
.env
.env.*
!.env.example

# Health data produced by local runs
*.db
*.db-journal
*.sqlite3
backend/storage/
storage/

# The supplied model is added deliberately by the owner, not by accident
ml_service/model/*.joblib

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Flutter / IDE (app/.gitignore covers the rest)
app/build/
.idea/
*.iml
.DS_Store

# Packaged build/deploy artifacts: regenerated by scripts/build-release.* and
# scripts/package-server.*, not source
release/
deploy/web/*
!deploy/web/README.txt

# Android release signing
app/android/key.properties
app/android/*.jks

# Local Heart ML virtual environment
heart_risk_api/.venv/
