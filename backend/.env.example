# Copy to .env and fill in. Never commit the real .env file.
SUSTHITI_ENV=development
DATABASE_URL=sqlite:///./susthiti.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SESSION_HOURS=168
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SECONDS=15
# Google AI Studio (Gemini). Leave empty to disable AI features (the app shows "AI unavailable").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=90
# Development only: enables the clearly-labelled DEMO wearable provider.
ENABLE_DEMO_WEARABLE=true
# Development only: returns the password-reset token in the API response because no email provider is configured.
DEV_EXPOSE_RESET_TOKEN=true
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=60
