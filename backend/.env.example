# Copy to .env and fill in. Never commit the real .env file.
SUSTHITI_ENV=development
DATABASE_URL=sqlite:///./susthiti.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SESSION_HOURS=168
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SECONDS=15
HEART_MODEL_SERVICE_URL=http://127.0.0.1:8002
HEART_MODEL_SERVICE_TIMEOUT_SECONDS=15
# OpenRouter (https://openrouter.ai/api/v1): server-side only, never shipped to Flutter.
# Leave empty to disable AI features (the app shows "AI unavailable").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
AI_TIMEOUT_SECONDS=90
# Path to a Firebase service-account JSON key. Leave empty to disable push notifications (the
# app still shows in-app notifications; only the system tray push is affected). Get this from
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
FCM_SERVICE_ACCOUNT_JSON=
# Development only: enables the clearly-labelled DEMO wearable provider.
ENABLE_DEMO_WEARABLE=true
# Development only: returns the password-reset token in the API response because no email provider is configured.
DEV_EXPOSE_RESET_TOKEN=true
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=60
