# Copy to .env on the server and fill in. Never share or commit the real .env.

# The server's address without https://. Your own domain (an A record pointing at the server),
# or a free one made from the server's IP address, e.g. for 203.0.113.10: 203-0-113-10.sslip.io
DOMAIN=

# Signs sign-in sessions. Generate on the server with:  openssl rand -base64 48
JWT_SECRET=

# Optional: OpenRouter key for AI report summaries and lifestyle insights.
# Leave empty to run without AI (the app says AI is not set up).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha

# How long a sign-in lasts, in hours (default 7 days).
SESSION_HOURS=168
